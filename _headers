/*
  Access-Control-Allow-Origin: *
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Shared header/footer fragments are fetched by js/layout.js, not visited.
# Keep them out of search results.
/header
  X-Robots-Tag: noindex
/footer
  X-Robots-Tag: noindex

/article
  Cache-Control: public, max-age=0, must-revalidate

/articles
  Cache-Control: public, max-age=0, must-revalidate

/js/main.js
  Cache-Control: public, max-age=0, must-revalidate

# All CSS and JS bundles revalidate on every request so a cache-busting
# `?v=` query bump (or a freshly-deployed asset) is picked up by browsers
# and the Cloudflare edge immediately, instead of waiting hours for the
# default cache to expire. Cheap because most checks return 304 Not Modified.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/posts/games/_doodle_template*
  Cache-Control: public, max-age=0, must-revalidate

/posts/games/_flappy_template*
  Cache-Control: public, max-age=0, must-revalidate

/doodlecharacter.png
  Cache-Control: public, max-age=0, must-revalidate

/flappybird.png
  Cache-Control: public, max-age=0, must-revalidate

# Homepage-beta drawing plates. Requested with a ?v= query from
# homepage-beta.html, so bump that (the V constant) whenever these
# files change; the URLs themselves can then be cached for a year.
/beta/*
  Cache-Control: public, max-age=31536000, immutable
